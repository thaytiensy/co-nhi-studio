# Firebase Web App configuration (public client configuration; set per deployment environment)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Chỉ phía máy chủ Vercel; không thêm tiền tố VITE_ và không commit giá trị thật.
GEMINI_API_KEY=

# Chỉ bật chat văn bản Gemini khi chủ ứng dụng chủ động cấu hình máy chủ.
ENABLE_GEMINI_CHAT=false

# Mặc định MIỄN PHÍ CỤC BỘ. Không bật khi chủ ứng dụng chưa đồng ý chi phí/hạn mức.
ENABLE_EXTERNAL_AI=false
VITE_ENABLE_EXTERNAL_AI=false
